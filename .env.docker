# Copy this to .env, then edit the values:  cp .env.docker .env
# docker compose automatically reads .env for these ${...} variables.

# ---- App ----
APP_NAME=Smart Agricultural Farm Management System
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Generate a strong one:  openssl rand -hex 32
SECRET_KEY=change-this-secret-key-before-production

# Replace 203.0.113.10 with your VPS public IP. This must list the URL you open
# the frontend at, so the browser is allowed to call the backend.
CORS_ORIGINS=http://203.0.113.10:3000,http://localhost:3000
